uniform shader image;
uniform float2 imageSize;
uniform float time;

half4 main(float2 coord) {
    half4 c = image.eval(coord);
    float3 bg = mix(c.rgb, float3(0.08, 0.12, 0.17) * c.a, 0.78);
    float2 center = float2(0.35, 0.22);
    float dist = length(coord - center * imageSize);
    float radius = imageSize.x * 0.067;
    float alpha = pow(1.0 - clamp(dist / radius, 0.0, 1.0), 2.0);
    return half4(mix(bg, float3(0.95, 0.96, 0.85) * c.a, alpha * 0.85), c.a);
}
